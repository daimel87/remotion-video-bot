# Pippit AI Configuration
# Requiere cuenta en https://www.pippit.ai/

# Bearer token para autenticación en Pippit API
PIPPIT_ACCESS_KEY=your_pippit_access_key_here

# URL base de Pippit API (por defecto)
PIPPIT_API_URL=https://api.pippit.ai

# Configuración de salida
PIPPIT_OUTPUT_DIR=./pippit-output
PIPPIT_DOWNLOAD_VIDEOS=true

# Configuración de redes sociales (opcional)
# Para publicación automática en redes sociales
PIPPIT_PUBLISH_TIKTOK=false
PIPPIT_PUBLISH_INSTAGRAM=false
PIPPIT_PUBLISH_FACEBOOK=false
