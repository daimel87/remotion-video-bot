# Configuración de Pippit AI para crear Shorts
# Crear cuenta gratuita en: https://www.pippit.ai/

# NOTA: Para el plan gratuito, no necesitas Access Key
# Solo usa Pippit directamente desde: https://www.pippit.ai/create

# Si instalas el skill en el futuro, aquí va tu clave:
# PIPPIT_ACCESS_KEY=tu_clave_aqui

# Configuración local
PIPPIT_OUTPUT_DIR=./pippit-output
PIPPIT_DOWNLOAD_VIDEOS=true
